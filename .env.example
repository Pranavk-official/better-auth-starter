# Environment variables declared in this file are NOT committed to git.
# Copy this file to .env and fill in your values.

# PostgreSQL connection string
# For local development (app running outside Docker, DB in Docker):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/better_auth_starter?schema=public"

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Used to send email-verification links (Nodemailer). Any SMTP provider works
# (e.g. Mailtrap/Mailpit for dev, Postmark/SES/Resend-SMTP for prod).
# If SMTP_HOST is left blank, the app logs the verification link to the server
# console in development instead of sending (and throws in production).
# Port 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Better Auth Starter <no-reply@example.com>"

# ─── Social Providers ────────────────────────────────────────────────────────
# Fill in credentials only for the providers you want to enable.
# Each provider's OAuth app must set the callback URL to:
#   http://localhost:3000/api/auth/callback/<provider>
# (Replace <provider> with: apple, discord, dropbox, facebook, github, gitlab,
#  google, linkedin, microsoft, reddit, roblox, spotify, tiktok, twitch, twitter)
# ─────────────────────────────────────────────────────────────────────────────

# Apple  https://developer.apple.com/
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Discord  https://discord.com/developers/applications
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Dropbox  https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=""
DROPBOX_CLIENT_SECRET=""

# Facebook  https://developers.facebook.com/
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# GitHub  https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitLab  https://gitlab.com/-/user_settings/applications
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""

# Google  https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LinkedIn  https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Microsoft  https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Reddit  https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Roblox  https://create.roblox.com/dashboard/credentials
ROBLOX_CLIENT_ID=""
ROBLOX_CLIENT_SECRET=""

# Spotify  https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# TikTok  https://developers.tiktok.com/  (uses CLIENT_KEY instead of CLIENT_ID)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Twitch  https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Twitter / X  https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
